# Copy to .env and fill in, then set credentials.source: env in config.yaml.
# Each value may be the PEM itself or a path to the .pem file.
#   chmod 600 .env
AGENT_ARMY_PROJECT_OWNER_GITHUB_APP_PRIVATE_KEY=/absolute/path/to/owen.private-key.pem
AGENT_ARMY_DEVELOPER_GITHUB_APP_PRIVATE_KEY=/absolute/path/to/devin.private-key.pem
AGENT_ARMY_OPTIMIZATION_REVIEWER_GITHUB_APP_PRIVATE_KEY=/absolute/path/to/spectacle.private-key.pem
AGENT_ARMY_DOCUMENTATION_GITHUB_APP_PRIVATE_KEY=/absolute/path/to/doku.private-key.pem
