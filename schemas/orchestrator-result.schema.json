{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 1
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_state": {
      "type": "string",
      "enum": [
        "needs-grooming",
        "needs-decision",
        "needs-documentation",
        "ready-for-development",
        "needs-user-guidance",
        "needs-requirements-challenge",
        "needs-design-signoff"
      ]
    },
    "requirements_challenge_round": {
      "type": "integer",
      "minimum": 1
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "accepted",
              "disputed"
            ]
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "disposition",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "final_design": {
      "type": "string"
    }
  },
  "required": [
    "summary",
    "evidence",
    "questions",
    "recommended_actions",
    "files_changed",
    "commands_run",
    "next_state"
  ],
  "additionalProperties": false
}
